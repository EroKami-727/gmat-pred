# Git ignore file for NASA GMAT Early Exit project

# Generated data (Parquet files, 60+ MB)
data/
!data/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
.venv/
env/
venv/

# Jupyter
.ipynb_checkpoints/

# GMAT output
gmat_scripts/output/
*.report
*.data

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Node / frontend generated files
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
frontend/.vite/
package-lock.json

# AI tool directories
.agents/
.kiro/
.trae/
.cursor/
.windsurf/
.copilot/
.claude/

# AI tool lock files
skills-lock.json

# Generated output files
trajectory.txt

# Model checkpoints and scalers (large binary files)
models/**/*.pt
models/**/*.pkl

# Generated reports
reports/

# Parquet split temps
data/_*_split.parquet

# Detached pipeline logs
.runlogs/
